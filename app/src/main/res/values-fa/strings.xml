    <!-- 0.4.0: Free WARP, speed, subscriptions, QR -->
    <string name="warp_name">WARP رایگان</string>
    <string name="warp_badge">رایگان</string>
    <string name="warp_hint">Cloudflare WARP، بدون نیاز به کانفیگ یا اشتراک. Bridge هر بار که وصل می‌شوید راهی برای عبور از شبکه‌ی شما پیدا می‌کند که ممکن است تا یک دقیقه طول بکشد. سایت‌ها آدرس Cloudflare می‌بینند و بعضی‌شان کپچا می‌خواهند.</string>
    <string name="warp_use">استفاده</string>
    <string name="warp_in_use">در حال استفاده</string>
    <string name="warp_method">روش اتصال</string>
    <string name="warp_auto">خودکار: سریع‌ترین</string>
    <string name="warp_foreign">خروجی خارج از ایران</string>
    <string name="warp_psiphon">WARP + Psiphon</string>
    <string name="warp_auto_hint">همه‌ی روش‌های سریع را هم‌زمان امتحان می‌کند و سریع‌ترینی که کار کند را نگه می‌دارد. خروجی معمولاً به نام ایران ثبت شده: فیلتر دور زده می‌شود، ولی سایت‌هایی که کاربران ایرانی را مسدود می‌کنند ممکن است باز نشوند.</string>
    <string name="warp_foreign_hint">دو روش دو مرحله‌ای را هم امتحان می‌کند و منتظرشان می‌ماند، چون خروجی‌شان خارج از ایران است. اتصال بیشتر طول می‌کشد، تا یک دقیقه، و سرعت کمتر است. اگر هیچ‌کدام نرسند، از راه دیگری با خروجی ایران وصل می‌شود و تا نیم ساعت منتظرشان نمی‌ماند.</string>
    <string name="warp_psiphon_hint">WARP از ایران معمولاً خروجی ایران می‌گیرد. Psiphon که داخل WARP اجرا می‌شود از کشور دیگری بیرون می‌رود، پس سایت‌هایی که کاربر ایرانی را قبول نمی‌کنند باز می‌شوند. کندتر است، اتصال تا یک دقیقه و نیم بیشتر طول می‌کشد و تماس‌ها و بازی‌هایی که از UDP استفاده می‌کنند ممکن است کار نکنند. ترافیک از شبکه‌ی Psiphon رد می‌شود.</string>
    <string name="warp_region">کشور خروجی</string>
    <string name="warp_region_any">هر کشوری</string>
    <string name="warp_unavailable">WARP رایگان به اندروید ۱۰ یا جدیدتر نیاز دارد.</string>
    <string name="warp_psiphon_failed">Psiphon در یک دقیقه و نیم از داخل WARP وصل نشد. برای استفاده از خود WARP روش اتصال دیگری انتخاب کنید.</string>
    <string name="warp_no_account">WARP رایگان نتوانست حساب WARP بسازد، چون سرویس WARP کلادفلر الان روی این شبکه مسدود است. کمی بعد یا روی شبکه‌ی دیگری دوباره امتحان کنید.</string>
    <string name="warp_no_way">WARP رایگان الان راهی برای عبور از این شبکه پیدا نکرد. جزئیات در لاگ‌ها هست.</string>
