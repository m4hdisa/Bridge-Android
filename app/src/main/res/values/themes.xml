<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only, like the Windows app. The screen itself is drawn by Compose (ui/Theme.kt); this is what shows while it starts. -->
    <style name="Theme.Bridge" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
